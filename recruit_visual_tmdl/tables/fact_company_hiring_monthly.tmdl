table fact_company_hiring_monthly
	lineageTag: ce61c7c7-78e1-471a-a4f1-9edc45c3946b

	/// Total postings from company hiring fact
	measure 'Total Company Postings' = SUMX(fact_company_hiring_monthly, VALUE(fact_company_hiring_monthly[postings_count]))
		formatString: #,##0
		displayFolder: Company Metrics
		lineageTag: 15c3cff0-9a68-43fc-862d-ca418e34fef8

	/// Postings in United States only
	measure 'US Postings' = CALCULATE([Total Company Postings], fact_company_hiring_monthly[job_country] = "United States")
		formatString: #,##0
		displayFolder: Geography
		lineageTag: 2b2c522d-a914-45f1-8e41-bf99a7548c06

	/// US postings as % of global total
	measure 'US Share of Global' = DIVIDE([US Postings], [Total Company Postings], 0)
		formatString: 0.0%
		displayFolder: Geography
		lineageTag: 140f7d14-929d-4115-92e2-28b876c389f0

