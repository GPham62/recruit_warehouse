		formatString: 0
		lineageTag: b9fd3d55-8d8c-48d8-adfb-d0626296b43d
		summarizeBy: sum
		sourceColumn: postings_count

		annotation SummarizationSetBy = Automatic

	column remote_postings_count
		dataType: int64
		formatString: 0
		lineageTag: fce07eaf-c9bf-48a1-8cab-de19862fd935
		summarizeBy: sum
		sourceColumn: remote_postings_count

		annotation SummarizationSetBy = Automatic

	column health_insurance_postings_count
