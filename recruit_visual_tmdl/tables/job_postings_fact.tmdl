table job_postings_fact
	lineageTag: 06e7472e-0a7b-4f65-bda4-875592dc75a3

	/// Total unique job postings in the fact table
	measure 'Total Unique Jobs' = COUNTROWS(job_postings_fact)
		formatString: #,##0
		displayFolder: Job Market
		lineageTag: 10e242f0-27dc-47ba-8b20-ed8b4f7a05b1

	/// Number of unique countries with job postings
	measure 'Countries Hiring' = DISTINCTCOUNT(job_postings_fact[job_country])
		formatString: #,##0
		displayFolder: Job Market
		lineageTag: 9bca0eeb-a94e-4c40-ae07-0f80deb3d129

