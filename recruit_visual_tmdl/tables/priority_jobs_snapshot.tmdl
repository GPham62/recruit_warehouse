table priority_jobs_snapshot
	lineageTag: ab415c29-eea6-4bfd-82ae-4c1c0eb66242

	/// Total number of priority job listings
	measure 'Total Priority Jobs' = COUNTROWS(priority_jobs_snapshot)
		formatString: #,##0
		displayFolder: Priority Metrics
		lineageTag: 5480ac20-3955-415f-802e-6af39b0d9f67

	/// Count of highest-priority (level 1) jobs
	measure 'Priority 1 Jobs' = CALCULATE(COUNTROWS(priority_jobs_snapshot), priority_jobs_snapshot[priority_lvl] = "1")
		formatString: #,##0
		displayFolder: Priority Metrics
		lineageTag: fd5ca413-18c4-4dde-8a6f-7ad2bbfa6556

	/// Average annual salary using safe text-to-number conversion
	measure 'Avg Salary (Priority Jobs)' =
			AVERAGEX(
			    FILTER(
			        priority_jobs_snapshot,
			        NOT(ISBLANK(priority_jobs_snapshot[salary_year_avg]))
			            && LEN(TRIM(priority_jobs_snapshot[salary_year_avg])) > 0
			    ),
			    IF(
			        ISERROR(VALUE(priority_jobs_snapshot[salary_year_avg])),
			        BLANK(),
			        VALUE(priority_jobs_snapshot[salary_year_avg])
			    )
			)
		formatString: $#,##0
		displayFolder: Priority Metrics
		lineageTag: 0646c1f3-a941-4fca-af40-5f95cccbe286

	/// Max salary using safe text-to-number conversion
	measure 'Max Salary' =
			MAXX(
			    FILTER(
			        priority_jobs_snapshot,
			        NOT(ISBLANK(priority_jobs_snapshot[salary_year_avg]))
			            && LEN(TRIM(priority_jobs_snapshot[salary_year_avg])) > 0
			    ),
			    IF(
			        ISERROR(VALUE(priority_jobs_snapshot[salary_year_avg])),
			        BLANK(),
			        VALUE(priority_jobs_snapshot[salary_year_avg])
			    )
			)
		formatString: $#,##0
		displayFolder: Priority Metrics
		lineageTag: be433f7d-5087-49bb-925d-4719188f2e12

	/// Priority 1 jobs as % of all priority jobs
	measure 'Priority 1 Share' = DIVIDE([Priority 1 Jobs], [Total Priority Jobs], 0)
		formatString: 0.0%
		displayFolder: Priority Metrics
		lineageTag: a2ecd0a5-ffb3-4fd5-8490-cd611c365883

	/// Difference between selected role salary and overall avg
	measure 'Salary vs Market Avg' =
			VAR RoleAvg = [Avg Salary (Priority Jobs)]
			VAR Overall = CALCULATE([Avg Salary (Priority Jobs)], ALL(priority_jobs_snapshot[job_title_short]))
			RETURN RoleAvg - Overall
		formatString: $#,##0
		displayFolder: Priority Metrics
		lineageTag: 42a60c84-0336-4bcd-88dd-b57643661a23

	column job_id
		dataType: string
		lineageTag: 82f18a0a-4eea-4419-a503-e79ca8757f8a
